PORT=8080
NODE_ENV=development
APP_NAME=Todo API
API_VERSION=1.0.0

# Database (used by `npm run dev`; docker-compose overrides DB_HOST with "db")
DB_HOST=localhost
DB_PORT=5432
DB_USER=todo
DB_PASSWORD=change_me
DB_NAME=tododb

# Auth (generate with: openssl rand -hex 32)
JWT_SECRET=change_me
JWT_EXPIRES_IN=1h
